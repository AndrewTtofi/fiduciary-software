// ORO MVP — Postgres schema
// Source of truth: §4 of prompt.md (data model) + §9.2 of the approved plan.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  prospect
  client
  staff
}

enum Lang {
  en
  ru
}

enum ProspectStatus {
  pending
  approved
  needs_info
  rejected
}

enum DocType {
  passport
  proof_of_address
  other
}

enum DocStatus {
  received
  under_review
  approved
  reupload_needed
}

enum ClientStatus {
  active
  on_hold
  completed
}

enum SvcStatus {
  pending
  in_progress
  completed
}

enum KeyDateStatus {
  upcoming
  overdue
  completed
}

enum BookingStatus {
  confirmed
  completed
  no_show
  cancelled
}

enum ComplianceStatus {
  open
  in_review
  cleared
  blocked
}

enum RiskRating {
  low
  standard
  high
}

enum PartyType {
  individual
  entity
}

enum PartyRole {
  main_contact
  ubo
  director
  shareholder
  signatory
  intermediary
}

enum KycCheckStatus {
  pending
  verified
  failed
}

enum KycCaseState {
  pending
  in_progress
  passed
  blocked
}

enum ScreeningOutcome {
  clear
  hits
  error
}

enum HitReviewStatus {
  unreviewed
  false_positive
  confirmed_match
  escalated
}

enum ReviewTaskKind {
  periodic_review
  screening_hit
  id_doc_review
  risk_assessment
}

enum ReviewTaskState {
  open
  completed
  dismissed
}

enum DocPurpose {
  passport
  proof_of_address
  sof
  other
}

enum DocumentRequestState {
  open
  fulfilled
  cancelled
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String?
  fullName      String
  phone         String?
  role          Role
  emailVerified DateTime?
  languagePref  Lang      @default(en)
  createdAt     DateTime  @default(now())
  deactivatedAt DateTime?

  prospect          Prospect?
  clientAccount     Client?
  reviewedProspects Prospect[]      @relation("Reviewer")
  primaryFor        Client[]        @relation("PrimaryStaff")
  internalNotes     InternalNote[]
  messages          Message[]
  expertBookings    Booking[]       @relation("Expert")
  activity          ActivityLog[]
  verificationTokens VerificationToken[]
  passwordResets    PasswordReset[]
  sessions          Session[]
  accounts          Account[]

  // Compliance back-relations
  complianceSignOffs   ComplianceFile[] @relation("ComplianceSigner")
  riskAssessments      ComplianceFile[] @relation("RiskAssessor")
  idvReviews           KycCase[]        @relation("IdvReviewer")
  screeningRuns        ScreeningRun[]   @relation("ScreeningRunner")
  hitReviews           ScreeningHit[]   @relation("HitReviewer")
  reviewTaskAssignments ReviewTask[]    @relation("ReviewAssignee")
  docRequestsMade      DocumentRequest[] @relation("DocRequestedBy")
  mediaUploads         MediaAsset[]

  @@index([role])
}

model Prospect {
  id               String         @id @default(uuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceNumber  String         @unique
  status           ProspectStatus @default(pending)
  servicesSelected Json
  draft            Json?
  completeness         String?    // auto-computed brief score: low | med | high
  completenessOverride String?    // staff override of the auto score
  createdAt        DateTime       @default(now())
  reviewedAt       DateTime?
  reviewedById     String?
  reviewedBy       User?          @relation("Reviewer", fields: [reviewedById], references: [id])
  /// The website lead this application was activated from (post-call invite
  /// link). Null for self-starters who used the public "Create account" form.
  leadId           String?        @unique
  lead             Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  /// Set when the first consultation already happened before the account was
  /// activated — the portal then shows "call done" instead of "book a call".
  consultationDoneAt DateTime?

  details        ProspectDetail[]
  documents      Document[]
  bookings       Booking[]
  messages       Message[]
  internalNotes  InternalNote[]
  client         Client?
  complianceFile ComplianceFile?

  @@index([status])
  @@index([referenceNumber])
}

model ProspectDetail {
  id         String   @id @default(uuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  fieldName  String
  fieldValue String

  @@index([prospectId, fieldName])
}

model Document {
  id           String    @id @default(uuid())
  prospectId   String
  prospect     Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  type         DocType
  storageKey   String
  encMeta      Json
  originalName String
  mime         String
  sizeBytes    Int
  status       DocStatus @default(received)
  uploadedAt   DateTime  @default(now())
  partyId      String?
  party        Party?    @relation(fields: [partyId], references: [id])
  purpose      DocPurpose @default(other)
  serviceTypeKey String?

  fulfillsRequest DocumentRequest? @relation("DocRequestFulfilledDoc")

  @@index([prospectId])
  @@index([partyId])
  @@index([serviceTypeKey])
}

model Client {
  id             String       @id @default(uuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  prospectId     String       @unique
  prospect       Prospect     @relation(fields: [prospectId], references: [id])
  companyName    String?
  status         ClientStatus @default(active)
  primaryStaffId String
  primaryStaff   User         @relation("PrimaryStaff", fields: [primaryStaffId], references: [id])
  createdAt      DateTime     @default(now())
  country              String?
  address              String?
  registrationNumber   String?
  vatNumber            String?
  taxResidency         String?
  engagementLetterDate DateTime?

  services         ClientService[]
  keyDates         KeyDate[]
  messages         Message[]
  internalNotes    InternalNote[]
  complianceFile   ComplianceFile?
  documentRequests DocumentRequest[]
  checklistItems   ChecklistItem[]
}

/// Staff-only manual checklist per client engagement ("Passport received",
/// "Proof of address received", …). Purely internal record-keeping: rendered
/// only inside /admin, never exposed through any client-facing query.
model ChecklistItem {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label     String
  done      Boolean  @default(false)
  doneAt    DateTime?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([clientId])
}

model ClientService {
  id                String    @id @default(uuid())
  clientId          String
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceType       String
  status            SvcStatus @default(pending)
  startDate         DateTime?
  notes             String?

  @@index([clientId])
}

model KeyDate {
  id          String        @id @default(uuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  description String
  dueDate     DateTime
  status      KeyDateStatus @default(upcoming)

  @@index([clientId, dueDate])
}

model Message {
  id          String   @id @default(uuid())
  prospectId  String?
  clientId    String?
  senderId    String
  body        String
  attachments Json?
  createdAt   DateTime @default(now())

  prospect Prospect? @relation(fields: [prospectId], references: [id])
  client   Client?   @relation(fields: [clientId], references: [id])
  sender   User      @relation(fields: [senderId], references: [id])

  @@index([prospectId, createdAt])
  @@index([clientId, createdAt])
}

model InternalNote {
  id         String   @id @default(uuid())
  prospectId String?
  clientId   String?
  authorId   String
  body       String
  createdAt  DateTime @default(now())

  prospect Prospect? @relation(fields: [prospectId], references: [id])
  client   Client?   @relation(fields: [clientId], references: [id])
  author   User      @relation(fields: [authorId], references: [id])

  @@index([prospectId, createdAt])
  @@index([clientId, createdAt])
}

model Booking {
  id              String        @id @default(uuid())
  /// Portal bookings belong to a prospect; public hard-bookings to a lead.
  /// Exactly one of the two is set.
  prospectId      String?
  prospect        Prospect?     @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  leadId          String?
  lead            Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  expertId        String
  expert          User          @relation("Expert", fields: [expertId], references: [id])
  startsAt        DateTime
  timezone        String
  durationMinutes Int           @default(30)
  status          BookingStatus @default(confirmed)
  /// Id of the mirrored event in the connected staff calendar (Google/Outlook),
  /// null when the calendar write failed or no calendar is connected.
  calendarEventId String?
  reminderSent24h Boolean       @default(false)
  reminderSent1h  Boolean       @default(false)

  @@index([startsAt])
  @@index([expertId, startsAt])
}

model ActivityLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

// --- Auth.js token storage (kept in DB even with JWT sessions) -----------

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id      String   @id @default(uuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token   String   @unique
  expires DateTime

  @@index([userId])
}

model PasswordReset {
  id      String   @id @default(uuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token   String   @unique
  expires DateTime
  usedAt  DateTime?

  @@index([userId])
}

model OrgSettings {
  id           String   @id @default("singleton")
  displayName  String   @default("the platform")
  contactEmail String?
  address      String?
  // White-label branding (single-org, one deployment per tenant)
  brandName    String?  // public-facing brand; falls back to displayName
  brandMark    String?  // single-letter wordmark; derived from name if null
  logo         String?  // uploaded logo as a data: URL (public); replaces the letter mark everywhere when set
  legalName    String?  // legal entity ("… Limited") for emails/legal pages; falls back to brand
  referencePrefix String? // prefix for reference numbers (e.g. "ORO"); derived from brand when null
  jurisdiction String?  // governing-law country for legal pages; defaults to "Cyprus"
  accentColor  String?  // hex; overrides the theme preset's brand colour
  themePreset  String   @default("indigo") // indigo | emerald | gold | burgundy | slate
  // Front-face (marketing + auth) UI template — key into FRONT_TEMPLATES
  // (src/lib/front-templates.ts): heritage | meridian | atelier | summit | clarity.
  // Super-admin managed (Settings → Site template).
  frontTemplate String  @default("heritage")
  // Per-deployment template overrides as { primary?, accent?, bg?,
  // displayFont?, bodyFont? } — validated by parseFrontOverrides(); invalid
  // keys are ignored so a broken row can never break the public site.
  frontTheme    Json?
  // Which public tools this deployment offers, as a { [toolKey]: boolean }
  // map over the code catalog (src/lib/data/tools.ts). Absent keys default
  // to enabled, so new tools ship on and a broken row shows everything.
  // Super-admin managed (Settings → Site tools).
  toolsEnabled  Json?
  // Plan tier gates feature availability (starter | professional | scale).
  // Defaults to the entry product: a deployment nobody has configured should
  // receive what was bought, not the full compliance suite by accident. Set
  // per deployment via the COMPANY_PLAN_TIER env var (ensure-branding) or in
  // Settings → Branding & plan.
  planTier     String   @default("starter")
  // Onboarding document-upload phase: "mandatory" (passport + proof required to
  // submit), "optional" (step shown, submit allowed with no docs), or "off"
  // (step removed entirely — onboarding becomes 2 steps).
  documentsPhase String @default("mandatory")
  // Whether clients/prospects can sign in to the portal at all. When off, the
  // public site hides client login and sign-up and visitors can only book
  // consultations; staff sign-in keeps working.
  clientLoginEnabled Boolean @default(true)
  // Per-section visibility overrides for the client dashboard, as a
  // { [sectionKey]: boolean } map. Absent keys fall back to the section's
  // code-defined default; plan-tier locking is enforced on top. See
  // src/lib/services/dashboard-sections.ts.
  dashboardSections Json?

  // ── Consultation scheduling ──────────────────────────────────────────
  // When the firm takes consultations. These were hard-coded constants in
  // src/lib/services/booking.ts, which meant a firm in another time zone, or
  // one taking Saturday calls, needed a code change and a redeploy.
  // Null/empty falls back to the code defaults, so an un-configured
  // deployment behaves exactly as before.
  //
  // Weekdays offered, 0 = Sunday … 6 = Saturday.
  consultDays        Int[]    @default([1, 2, 3, 4, 5])
  // Working windows as "HH:MM-HH:MM" on the firm's own wall clock. Slots are
  // generated inside these every `consultIntervalMins`; two windows give the
  // usual lunch gap. Listing every start time by hand does not scale — a 09:00
  // to 18:00 day at 30 minutes is 18 of them.
  consultRanges      String[] @default(["09:00-12:00", "14:00-17:00"])
  // How often a slot starts inside a window.
  consultIntervalMins Int     @default(60)
  // Length of a consultation, and how much warning staff get before one.
  // Shorter than the interval leaves a gap between calls.
  consultMinutes     Int      @default(30)
  consultNoticeMins  Int      @default(60)
  // How far ahead the picker opens.
  consultHorizonDays Int      @default(14)
  // IANA zone the wall-clock times above are anchored to.
  consultTimezone    String   @default("Europe/Nicosia")

  updatedAt    DateTime @updatedAt
}

/// CRM lead — anonymous/early-funnel contacts captured before a full
/// application exists (tax-calculator reveals, abandoned intake "save & exit",
/// public contact/booking form).
model Lead {
  id             String   @id @default(uuid())
  name           String?
  email          String
  phone          String?  // phone/WhatsApp as given on the contact form
  serviceKey     String?
  source         String   // calculator | intake | manual | contact
  stage          String   @default("lead")
  note           String?  // free-text context (e.g. "Tax calc: Cyprus", "Abandoned intake")
  meta           Json?    // extra form fields (country, nationality, preferred slot, …)
  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  /// Post-call activation: when the onboarding link was last emailed, and the
  /// account it turned into once the prospect clicked it.
  activationSentAt DateTime?
  activatedAt      DateTime?
  activatedUserId  String?

  bookings    Booking[]
  activations LeadActivation[]
  prospect    Prospect?

  @@index([email])
  @@index([createdAt])
}

/// Single-use, expiring, hashed-at-rest token that turns a lead into an
/// authenticated prospect account (the post-call "activate your account"
/// link). Reissuing revokes every earlier token for the lead.
model LeadActivation {
  id          String    @id @default(uuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expires     DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([leadId])
}

/// Editable marketing-site content (landing + FAQ copy). Singleton JSON blob,
/// merged over code defaults so new fields degrade gracefully.
model SiteContent {
  id        String   @id @default("singleton")
  data      Json
  updatedAt DateTime @updatedAt
}

/// Editable Cyprus tax rates + filing calendar behind the public /tools
/// pages. Stored as a JSON blob merged over the code defaults in
/// lib/data/tax-rates.ts so the firm can roll figures forward each year
/// without a developer.
model ToolSettings {
  id        String   @id @default("singleton")
  data      Json
  updatedAt DateTime @updatedAt
}

/// Publicly served images for the marketing site (article card images and
/// photos placed inside article bodies). Deliberately NOT routed through the
/// storage provider: that seam encrypts every object and serves it only to an
/// authenticated user, which is correct for client documents and wrong for a
/// public blog image. Bytes live in Postgres so a deployment keeps one backup
/// story and one container, matching the self-hosted single-stack model.
model MediaAsset {
  id           String   @id @default(uuid())
  filename     String
  mime         String
  sizeBytes    Int
  data         Bytes
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

/// Self-serve Insights articles (public blog). Staff write and publish these
/// from the admin with no developer involved; clean URLs via `slug`.
model Article {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  keyword     String // the one search phrase this article targets (SEO; not shown as a tag)
  /// Editorial category shown on cards and used by the Insights filter
  /// (Tax · Residency · Immigration · Citizenship · Company Formation · International).
  category    String    @default("Tax")
  excerpt     String // teaser shown on cards and list pages
  body        String // markdown body
  image       String? // card/header image URL (optional)
  /// Named author — every article carries one (credibility + search).
  author      String    @default("")
  authorRole  String    @default("")
  authorBio   String    @default("")
  /// "Correct as at" date shown under the title, next to the publication date.
  correctAsAt DateTime?
  /// Per-article SEO overrides; empty → derived from title/excerpt.
  metaTitle   String    @default("")
  metaDesc    String    @default("")
  /// Service page this article relates to (services/[key]); links the closing CTA.
  serviceKey  String    @default("")
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
  @@index([published, category])
}

model Service {
  id          String   @id @default(uuid())
  key         String   @unique
  label       String
  description String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  /// Per-service wording for the three progress stages shown to clients
  /// ({ pending, in_progress, completed } → label). Null → built-in defaults.
  /// Editable by firm staff at /admin/status-stages — no developer needed.
  stageLabels Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// --- Compliance (KYC/AML) -----------------------------------------------

model ComplianceFile {
  id                  String   @id @default(uuid())
  prospectId          String?  @unique
  prospect            Prospect? @relation(fields: [prospectId], references: [id])
  clientId            String?  @unique
  client              Client?  @relation(fields: [clientId], references: [id])

  status              ComplianceStatus @default(open)

  signedOffById       String?
  signedOff           User?    @relation("ComplianceSigner", fields: [signedOffById], references: [id])
  signedOffAt         DateTime?
  signedOffNote       String?

  riskComputed        RiskRating?
  riskComputedScore   Int?
  riskRating          RiskRating?
  riskOverrideReason  String?
  riskAssessedAt      DateTime?
  riskAssessedById    String?
  riskAssessedBy      User?    @relation("RiskAssessor", fields: [riskAssessedById], references: [id])

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  parties             Party[]
  reviewTasks         ReviewTask[]

  @@index([status])
}

model Party {
  id                  String   @id @default(uuid())
  complianceFileId    String
  complianceFile      ComplianceFile @relation(fields: [complianceFileId], references: [id], onDelete: Cascade)

  type                PartyType
  role                PartyRole
  fullName            String
  dateOfBirth         DateTime?
  nationality         String?
  countryOfResidence  String?
  passportNumber      String?
  registrationNumber  String?
  jurisdiction        String?
  ownershipPct        Decimal? @db.Decimal(5, 2)
  isPep               Boolean  @default(false)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  kycCase             KycCase?
  documents           Document[]

  @@index([complianceFileId])
}

model KycCase {
  id                    String   @id @default(uuid())
  partyId               String   @unique
  party                 Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)

  idvStatus             KycCheckStatus @default(pending)
  idvReviewedById       String?
  idvReviewedBy         User?    @relation("IdvReviewer", fields: [idvReviewedById], references: [id])
  idvReviewedAt         DateTime?
  idvNote               String?

  passportDocId         String?
  proofOfAddressDocId   String?
  sofDocId              String?
  sofNote               String?

  latestScreeningRunId  String? @unique
  latestScreeningRun    ScreeningRun? @relation("LatestScreening", fields: [latestScreeningRunId], references: [id])

  state                 KycCaseState @default(pending)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  screeningRuns         ScreeningRun[]  @relation("CaseRuns")

  @@index([state])
}

model ScreeningRun {
  id              String   @id @default(uuid())
  kycCaseId       String
  kycCase         KycCase  @relation("CaseRuns", fields: [kycCaseId], references: [id], onDelete: Cascade)

  provider        String
  query           Json
  ranAt           DateTime @default(now())
  ranByActorId    String?
  ranByActor      User?    @relation("ScreeningRunner", fields: [ranByActorId], references: [id])
  outcome         ScreeningOutcome
  hitCount        Int      @default(0)
  rawResponse     Json?
  errorMessage    String?

  hits            ScreeningHit[]
  latestForCase   KycCase?  @relation("LatestScreening")

  @@index([kycCaseId, ranAt])
}

model ScreeningHit {
  id              String   @id @default(uuid())
  screeningRunId  String
  screeningRun    ScreeningRun @relation(fields: [screeningRunId], references: [id], onDelete: Cascade)

  externalId      String
  matchedName     String
  matchedSchema   String
  matchedTopics   String[]
  matchScore      Float
  matchedListings Json
  matchUrl        String?

  reviewStatus    HitReviewStatus @default(unreviewed)
  reviewedById    String?
  reviewedBy      User?    @relation("HitReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  reviewNote      String?

  @@index([screeningRunId])
  @@index([externalId])
}

model ReviewTask {
  id                String   @id @default(uuid())
  complianceFileId  String
  complianceFile    ComplianceFile @relation(fields: [complianceFileId], references: [id], onDelete: Cascade)

  kind              ReviewTaskKind
  dueAt             DateTime?
  state             ReviewTaskState @default(open)
  assignedToId      String?
  assignedTo        User?    @relation("ReviewAssignee", fields: [assignedToId], references: [id])
  note              String?
  completedAt       DateTime?

  createdAt         DateTime @default(now())

  @@index([complianceFileId, state])
  @@index([assignedToId, state])
}

model DocumentRequest {
  id                  String    @id @default(uuid())
  clientId            String
  client              Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  description         String
  serviceTypeKey      String?
  requestedById       String
  requestedBy         User      @relation("DocRequestedBy", fields: [requestedById], references: [id])
  dueAt               DateTime?
  state               DocumentRequestState @default(open)
  fulfilledById       String?
  fulfilledAt         DateTime?
  fulfilledDocumentId String?   @unique
  fulfilledDocument   Document? @relation("DocRequestFulfilledDoc", fields: [fulfilledDocumentId], references: [id])
  createdAt           DateTime  @default(now())

  @@index([clientId, state])
}
